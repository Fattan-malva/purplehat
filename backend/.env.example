# ============================================================================
# Purplehat backend - contoh konfigurasi
# Salin file ini menjadi ".env" lalu isi sesuai environment Anda:
#     copy .env.example .env      (Windows)
#     cp   .env.example .env      (Linux/macOS)
# File ".env" TIDAK ikut ter-commit (lihat .gitignore).
# ============================================================================

# ---------- SQL Server (database PurpleHat) ----------
# Nama driver ODBC yang terpasang. Cek dengan:  python -c "import pyodbc;print(pyodbc.drivers())"
# Di container Linux (Debian 13) dipasang msodbcsql18 -> gunakan Driver 18.
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=192.168.234.182
DB_PORT=1433
DB_NAME=PurpleHat
# Jika pakai SQL Authentication:
DB_USER=sa
DB_PASSWORD=ubah-password-ini
# Set "yes" untuk Windows Authentication (mengabaikan DB_USER/DB_PASSWORD)
DB_TRUSTED_CONNECTION=no
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# ---------- MPV player (sumber Karaoke) ----------
# Cara menjalankan mpv:
#   auto     -> sambung ke mpv yang sudah jalan (mis. dijalankan player Flutter);
#               kalau tidak ada baru spawn sendiri.  (DEFAULT)
#   external -> JANGAN spawn; hanya sambung ke pipe. Player Flutter yang
#               menjalankan mpv.exe yang ikut ter-bundle.
#   spawn    -> selalu jalankan mpv sendiri (perilaku lama / tanpa Flutter).
MPV_LAUNCH=auto
# Path ke mpv.exe (dipakai HANYA saat MPV_LAUNCH=auto/spawn dan mpv belum
# berjalan). Kosongkan "mpv" bila sudah ada di PATH.
MPV_PATH=mpv
# Named pipe untuk IPC mpv. HARUS SAMA dengan `mpvPipe` di
# purplehat-flutter/lib/config.dart.
MPV_IPC_PIPE=\\.\pipe\purplehat-mpv
# Argumen tambahan mpv (opsional), pisahkan dengan spasi. Hanya dipakai saat
# backend spawn sendiri; kalau Flutter yang menjalankan mpv, atur argumennya di
# purplehat-flutter/lib/config.dart.
MPV_EXTRA_ARGS=--fs
# Channel default untuk "musik" pada lagu karaoke L/R (kiri/kanan).
# Banyak file karaoke: kanal L = musik, kanal R = vokal. Sesuaikan bila perlu.
KARAOKE_MUSIC_CHANNEL=left